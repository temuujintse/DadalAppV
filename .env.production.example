# Production settings for docker-compose.prod.yml.
# Copy to .env.production (git-ignored) and replace every value. Never commit real secrets.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

POSTGRES_USER=family_habit
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=family_habit

# Host port the API binds to on 127.0.0.1 (the reverse proxy forwards to it).
API_PORT=3000
# Explicit origins only ("*" is refused in production). The mobile app does not need CORS;
# list your web/admin origins here.
CORS_ORIGINS=https://familyhabit.example
SWAGGER_ENABLED=false

JWT_ACCESS_SECRET=replace-with-48-random-bytes
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
INVITE_TOKEN_SECRET=replace-with-another-48-random-bytes
INVITE_TTL_HOURS=72

OFFLINE_SYNC_WINDOW_DAYS=3
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AUTH=10

# ─── Runtime ───
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed CORS origins ("*" only in development).
CORS_ORIGINS=*

# ─── Database (docker compose exposes PostgreSQL on 5433) ───
DATABASE_URL=postgresql://family_habit:family_habit_dev@localhost:5433/family_habit?schema=public

# ─── Auth ───
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Pepper for hashing family invite codes (HMAC-SHA256).
INVITE_TOKEN_SECRET=change-me-to-another-long-random-string-32-chars
INVITE_TTL_HOURS=72

# ─── Offline sync ───
# Past local days an offline completion can still be synced for.
OFFLINE_SYNC_WINDOW_DAYS=3

# ─── Rate limiting (requests per minute) ───
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AUTH=10

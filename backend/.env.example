# ─── Runtime ───
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed CORS origins ("*" only in development).
CORS_ORIGINS=*

# ─── Database (docker compose exposes PostgreSQL on 5433) ───
DATABASE_URL=postgresql://family_habit:family_habit_dev@localhost:5433/family_habit?schema=public

# ─── Auth ───
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Pepper for hashing family invite codes (HMAC-SHA256).
INVITE_TOKEN_SECRET=change-me-to-another-long-random-string-32-chars
INVITE_TTL_HOURS=72

# ─── Offline sync ───
# Past local days an offline completion can still be synced for.
OFFLINE_SYNC_WINDOW_DAYS=3

# ─── Rate limiting (requests per minute) ───
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AUTH=10

# ─── E-mail (password reset) ───
# Resend API key; leave empty in development (codes are printed to the server log).
# RESEND_API_KEY=
# MAIL_FROM=Family Habit <no-reply@familyhabit.example>
PASSWORD_RESET_TTL_MINUTES=15

# ─── Push ───
# Only if "Enhanced push security" is enabled for the Expo project.
# EXPO_ACCESS_TOKEN=

# ─── AI (src/ai) — the OpenAI key stays on the server, never in the app ───
# Without a key the AI coach shows "not configured"; the rest of the app is unaffected.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=30000
AI_ENABLED=true
AI_DAILY_USER_LIMIT=10
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=1200
AI_CONVERSATION_RETENTION_DAYS=30

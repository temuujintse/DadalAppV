# syntax=docker/dockerfile:1.7
#
# Family Habit API — image for Render (and other single-container hosts).
# Render runs one container per service and its free plan has no pre-deploy hook, so this
# image applies migrations and the idempotent reference seed on start, then boots the API.
# `prisma migrate deploy` takes a database advisory lock, so concurrent starts are safe.
# For a self-managed server prefer ./Dockerfile (slim runtime + separate migrate job).

FROM node:22-bookworm-slim
WORKDIR /app
ENV CI=true NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false

# Prisma's schema engine (migrate) needs OpenSSL.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json prisma.config.ts ./
COPY prisma ./prisma
# Placeholder only so prisma.config.ts loads during `prisma generate`; never used to connect.
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build npm ci

COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY src ./src
RUN npm run build

ENV NODE_ENV=production
USER node
EXPOSE 10000
CMD ["sh", "-c", "npx prisma migrate deploy && npx prisma db seed && exec node dist/main"]

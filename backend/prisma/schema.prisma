// Family Habit — PostgreSQL schema (Prisma 7)
//
// Conventions
// - UUID primary keys (generated by PostgreSQL).
// - All timestamps are stored in UTC (timestamptz). "Local calendar day" values
//   (completions, streaks, quests) are stored as DATE computed on the server from
//   the user's/habit's IANA timezone.
// - XPTransaction and AuditLog are append-only. UPDATE/DELETE is blocked by a
//   database trigger (see the init migration).
// - Soft delete (deletedAt) for user-facing aggregates (User, Family, Habit, Reward).
//   History rows (completions, XP ledger, audit) are never cascaded away.
// - Raw-SQL CHECK constraints in the migrations enforce cross-column rules that
//   Prisma cannot express (habit type/mode, XP wallet ownership, value ranges).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

enum FamilyRole {
  OWNER
  PARENT
  MEMBER
  CHILD
}

enum FamilyPlan {
  FREE
  PREMIUM
}

enum HabitType {
  PERSONAL
  FAMILY
}

enum HabitCompletionMode {
  PER_MEMBER
  SHARED
}

enum HabitDifficulty {
  EASY
  MEDIUM
  HARD
}

enum HabitStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CompletionSource {
  ONLINE
  OFFLINE_SYNC
}

enum XPWalletType {
  PERSONAL
  FAMILY
  PET
}

enum XPTransactionKind {
  EARN
  SPEND
  REVERSAL
  ADJUSTMENT
}

enum XPSourceType {
  HABIT_COMPLETION
  COMPLETION_REVERSAL
  QUEST
  ACHIEVEMENT
  PET_CARE
  REWARD_REDEMPTION
  ADMIN_ADJUSTMENT
}

enum PetCareType {
  FEED
  PLAY
  PET
  BATH
}

enum PetAccessorySlot {
  HEAD
  FACE
  NECK
  BODY
  BACKGROUND
}

enum PetAccessoryRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum AccessoryUnlockType {
  DEFAULT
  PET_LEVEL
  USER_LEVEL
  ACHIEVEMENT
}

enum QuestPeriod {
  DAILY
  WEEKLY
}

enum QuestScope {
  USER
  FAMILY
}

enum QuestGoalType {
  COMPLETE_HABITS
  COMPLETE_FAMILY_HABITS
  COMPLETE_ALL_TODAY
  PET_CARE
  EARN_XP
}

enum QuestProgressStatus {
  IN_PROGRESS
  COMPLETED
  CLAIMED
}

enum AchievementCondition {
  FIRST_COMPLETION
  STREAK_DAYS
  ACTIVE_HABITS
  FAMILY_QUESTS_COMPLETED
  TOTAL_COMPLETION_DAYS
  PET_LEVEL
  USER_LEVEL
}

enum RedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  REDEEMED
  CANCELLED
}

enum NotificationType {
  HABIT_REMINDER
  DAILY_PROGRESS
  STREAK_REMINDER
  QUEST_COMPLETED
  LEVEL_UP
  ACHIEVEMENT_UNLOCKED
  FAMILY_ACTIVITY
  REWARD_APPROVED
  REWARD_REQUESTED
  PET_ACCESSORY_UNLOCKED
  REWARD_REJECTED
}

enum PushPlatform {
  IOS
  ANDROID
}

enum SyncOperationType {
  HABIT_COMPLETION
  COMPLETION_UNDO
  PET_CARE
}

enum SyncOperationStatus {
  PENDING
  PROCESSED
  REJECTED
  CONFLICT
  FAILED
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stored lower-cased; uniqueness is case-insensitive by construction.
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?  @db.Timestamptz(3)

  profile            UserProfile?
  sessions           AuthSession[]
  passwordResets     PasswordReset[]
  aiPreference       AIUserPreference?
  aiConversations    AIConversation[]
  aiRecommendations  AIRecommendation[]
  aiUsage            AIUsageLog[]
  pushTokens         PushToken[]
  familyMembership   FamilyMember?
  createdFamilies    Family[]           @relation("FamilyCreatedBy")
  createdInvites     FamilyInvite[]     @relation("InviteCreatedBy")
  createdHabits      Habit[]            @relation("HabitCreator")
  habitAssignments   HabitAssignment[]  @relation("AssignmentUser")
  assignmentsMade    HabitAssignment[]  @relation("AssignmentAssignedBy")
  completions        HabitCompletion[]  @relation("CompletionOwner")
  completionsDone    HabitCompletion[]  @relation("CompletionActor")
  habitStreaks       HabitStreak[]
  gamification       UserGamification?
  xpTransactions     XPTransaction[]
  pet                UserPet?
  petCareActions     PetCareAction[]
  questProgress      QuestProgress[]
  createdQuests      Quest[]            @relation("QuestCreatedBy")
  achievements       UserAchievement[]
  createdRewards     Reward[]           @relation("RewardCreatedBy")
  redemptions        RewardRedemption[] @relation("RedemptionRequester")
  decidedRedemptions RewardRedemption[] @relation("RedemptionDecider")
  notifications      Notification[]
  syncOperations     SyncOperation[]

  @@index([status])
}

/// Minimal profile. Children's data is intentionally limited to a display name and an avatar preset.
model UserProfile {
  userId                String    @id @db.Uuid
  displayName           String    @db.VarChar(50)
  /// Preset avatar key (no photo uploads in v1 → less personal data).
  avatarKey             String    @default("fox") @db.VarChar(40)
  /// IANA timezone, e.g. "Asia/Ulaanbaatar".
  timezone              String    @default("Asia/Ulaanbaatar") @db.VarChar(64)
  locale                String    @default("mn") @db.VarChar(10)
  /// Per-type notification switches: { "HABIT_REMINDER": true, ... }
  notificationSettings  Json      @default("{}")
  onboardingCompletedAt DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One row per signed-in device. The refresh token is opaque ("<sessionId>.<secret>");
/// only a SHA-256 hash of the secret is stored. Rotated on every refresh.
/// One-time password reset code (6 digits, e-mailed). Only an HMAC of the code is stored.
model PasswordReset {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @db.VarChar(128)
  attempts  Int       @default(0)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Expo push token of a signed-in device. A token belongs to the user who registered it last.
model PushToken {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String       @db.Uuid
  token     String       @unique @db.VarChar(255)
  platform  PushPlatform
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @db.VarChar(128)
  userAgent        String?   @db.VarChar(255)
  expiresAt        DateTime  @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  revokeReason     String?   @db.VarChar(40)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// ───────────────────────────── Family ─────────────────────────────

model Family {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String     @db.VarChar(60)
  avatarKey          String     @default("home") @db.VarChar(40)
  timezone           String     @default("Asia/Ulaanbaatar") @db.VarChar(64)
  /// Subscription-ready: v1 is FREE with unlimited members (memberLimit = null).
  plan               FamilyPlan @default(FREE)
  memberLimit        Int?
  /// Family setting (OWNER/PARENT): show the in-family XP leaderboard. Child-safety opt-out.
  leaderboardEnabled Boolean    @default(true)
  createdById        String     @db.Uuid
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?  @db.Timestamptz(3)

  createdBy      User                @relation("FamilyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  members        FamilyMember[]
  invites        FamilyInvite[]
  habits         Habit[]
  completions    HabitCompletion[]
  sharedStreaks  FamilyHabitStreak[]
  gamification   FamilyGamification?
  xpTransactions XPTransaction[]
  quests         Quest[]
  questProgress  QuestProgress[]
  rewards        Reward[]
  redemptions    RewardRedemption[]

  @@index([deletedAt])
}

/// A user belongs to at most one family: `userId` is UNIQUE.
/// Leaving a family deletes this row only; completions and XP history stay.
model FamilyMember {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId    String     @db.Uuid
  userId      String     @unique @db.Uuid
  role        FamilyRole @default(MEMBER)
  invitedById String?    @db.Uuid
  joinedAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([familyId, role])
}

/// Invite codes are random and stored only as an HMAC-SHA256 hash.
model FamilyInvite {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId    String     @db.Uuid
  createdById String     @db.Uuid
  tokenHash   String     @unique @db.VarChar(128)
  /// Role granted on join. OWNER is never allowed (CHECK constraint).
  role        FamilyRole @default(MEMBER)
  maxUses     Int        @default(1)
  usedCount   Int        @default(0)
  expiresAt   DateTime   @db.Timestamptz(3)
  revokedAt   DateTime?  @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User   @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([familyId, revokedAt, expiresAt])
}

// ───────────────────────────── Habits ─────────────────────────────

/// PERSONAL: familyId = null, completionMode = null.
/// FAMILY:   familyId and completionMode are required (CHECK constraint).
model Habit {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId      String               @db.Uuid
  familyId       String?              @db.Uuid
  title          String               @db.VarChar(80)
  description    String?              @db.VarChar(500)
  icon           String               @default("sparkles") @db.VarChar(40)
  color          String               @default("#F97316") @db.VarChar(9)
  type           HabitType
  completionMode HabitCompletionMode?
  difficulty     HabitDifficulty      @default(EASY)
  status         HabitStatus          @default(ACTIVE)
  startDate      DateTime             @db.Date
  endDate        DateTime?            @db.Date
  timezone       String               @default("Asia/Ulaanbaatar") @db.VarChar(64)
  /// Local "HH:mm" reminder time; null = no reminder.
  reminderTime   String?              @db.VarChar(5)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?            @db.Timestamptz(3)

  creator           User               @relation("HabitCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  family            Family?            @relation(fields: [familyId], references: [id], onDelete: Restrict)
  assignments       HabitAssignment[]
  scheduleDays      HabitScheduleDay[]
  completions       HabitCompletion[]
  aiRecommendations AIRecommendation[]
  streaks           HabitStreak[]
  familyStreak      FamilyHabitStreak?

  @@index([familyId, status])
  @@index([creatorId, status])
}

model HabitAssignment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  habitId      String   @db.Uuid
  userId       String   @db.Uuid
  assignedById String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  habit      Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user       User  @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User  @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([habitId, userId])
  @@index([userId])
}

/// weekday: 0 = Sunday … 6 = Saturday (JavaScript convention).
model HabitScheduleDay {
  habitId String @db.Uuid
  weekday Int    @db.SmallInt

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@id([habitId, weekday])
}

/// Uniqueness per local day is enforced by `completionKey`:
///   PERSONAL / PER_MEMBER → "<habitId>:<userId>:<YYYY-MM-DD>"
///   SHARED                → "<habitId>:shared:<YYYY-MM-DD>"   (userId = null)
/// `idempotencyKey` is client-generated and scoped to the acting user.
model HabitCompletion {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  habitId         String           @db.Uuid
  familyId        String?          @db.Uuid
  /// Owner of the completion. NULL for SHARED family habits.
  userId          String?          @db.Uuid
  /// The member who actually tapped "complete".
  completedById   String           @db.Uuid
  localDate       DateTime         @db.Date
  completionKey   String           @unique @db.VarChar(120)
  idempotencyKey  String           @db.VarChar(64)
  note            String?          @db.VarChar(280)
  source          CompletionSource @default(ONLINE)
  clientCreatedAt DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)

  habit       Habit   @relation(fields: [habitId], references: [id], onDelete: Restrict)
  family      Family? @relation(fields: [familyId], references: [id], onDelete: Restrict)
  user        User?   @relation("CompletionOwner", fields: [userId], references: [id], onDelete: Restrict)
  completedBy User    @relation("CompletionActor", fields: [completedById], references: [id], onDelete: Restrict)

  @@unique([completedById, idempotencyKey])
  @@index([habitId, localDate])
  @@index([userId, localDate])
  @@index([familyId, localDate])
}

/// Streak for PERSONAL and PER_MEMBER habits — one row per (habit, user).
model HabitStreak {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  habitId           String    @db.Uuid
  userId            String    @db.Uuid
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastCompletedDate DateTime? @db.Date
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, userId])
  @@index([userId])
}

/// Streak for SHARED family habits — one row per habit, kept at family level.
model FamilyHabitStreak {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  habitId           String    @unique @db.Uuid
  familyId          String    @db.Uuid
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastCompletedDate DateTime? @db.Date
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  habit  Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

// ───────────────────────────── Gamification ─────────────────────────────

/// Read-optimised aggregate. Source of truth is the XPTransaction ledger.
/// lifetimeXP drives the level (never decreases on spending); balanceXP is spendable on rewards.
model UserGamification {
  userId             String    @id @db.Uuid
  lifetimeXP         Int       @default(0)
  balanceXP          Int       @default(0)
  level              Int       @default(1)
  totalCompletions   Int       @default(0)
  /// Number of distinct local days with at least one completion.
  completionDays     Int       @default(0)
  lastCompletionDate DateTime? @db.Date
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FamilyGamification {
  familyId        String   @id @db.Uuid
  lifetimeXP      Int      @default(0)
  level           Int      @default(1)
  questsCompleted Int      @default(0)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

/// Immutable XP ledger (UPDATE/DELETE blocked by trigger). Corrections are REVERSAL rows.
/// Exactly one owner column is set, matching walletType (CHECK constraint).
model XPTransaction {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletType     XPWalletType
  kind           XPTransactionKind
  userId         String?           @db.Uuid
  familyId       String?           @db.Uuid
  petId          String?           @db.Uuid
  /// Positive for EARN, negative for SPEND/REVERSAL.
  amount         Int
  sourceType     XPSourceType
  sourceId       String?           @db.Uuid
  /// Server-generated, e.g. "completion:<id>:PERSONAL". Prevents double awards.
  idempotencyKey String            @unique @db.VarChar(160)
  /// Who triggered the transaction (may differ from the wallet owner, e.g. SHARED completions).
  actorId        String?           @db.Uuid
  metadata       Json?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)

  user   User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  family Family?  @relation(fields: [familyId], references: [id], onDelete: Restrict)
  pet    UserPet? @relation(fields: [petId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([familyId, createdAt])
  @@index([petId, createdAt])
  @@index([sourceType, sourceId])
}

model Achievement {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String               @unique @db.VarChar(60)
  title       String               @db.VarChar(80)
  description String               @db.VarChar(280)
  icon        String               @db.VarChar(40)
  condition   AchievementCondition
  threshold   Int                  @default(1)
  xpReward    Int
  sortOrder   Int                  @default(0)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)

  userAchievements UserAchievement[]
  accessories      PetAccessory[]
}

model UserAchievement {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @db.Uuid
  achievementId String    @db.Uuid
  unlockedAt    DateTime  @default(now()) @db.Timestamptz(3)
  claimedAt     DateTime? @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)

  @@unique([userId, achievementId])
}

// ───────────────────────────── Pet ─────────────────────────────

model UserPet {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @unique @db.Uuid
  name               String    @default("Бамбаа") @db.VarChar(30)
  species            String    @default("FOX") @db.VarChar(30)
  level              Int       @default(1)
  lifetimeXP         Int       @default(0)
  /// 0–100 as of `happinessUpdatedAt`. Read-time decay is gentle and floored (never punitive);
  /// neglect never removes XP, level or accessories.
  happiness          Int       @default(80)
  happinessUpdatedAt DateTime  @default(now()) @db.Timestamptz(3)
  lastCaredAt        DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  careActions    PetCareAction[]
  accessories    UserPetAccessory[]
  xpTransactions XPTransaction[]
}

model PetCareAction {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  petId          String      @db.Uuid
  userId         String      @db.Uuid
  type           PetCareType
  localDate      DateTime    @db.Date
  xpAwarded      Int
  happinessDelta Int
  idempotencyKey String      @db.VarChar(64)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  pet  UserPet @relation(fields: [petId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([petId, type, createdAt])
}

/// Accessory catalog.
model PetAccessory {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key           String              @unique @db.VarChar(60)
  name          String              @db.VarChar(60)
  slot          PetAccessorySlot
  rarity        PetAccessoryRarity  @default(COMMON)
  unlockType    AccessoryUnlockType
  unlockValue   Int?
  achievementId String?             @db.Uuid
  /// Rive/Lottie asset or layer name used by the animation layer.
  assetKey      String              @db.VarChar(60)
  sortOrder     Int                 @default(0)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)

  achievement Achievement?       @relation(fields: [achievementId], references: [id], onDelete: SetNull)
  owners      UserPetAccessory[]
}

/// Ownership. `equippedSlot` is set only while equipped → @@unique([petId, equippedSlot])
/// guarantees one equipped item per slot (NULLs are distinct in PostgreSQL).
model UserPetAccessory {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  petId        String            @db.Uuid
  accessoryId  String            @db.Uuid
  equippedSlot PetAccessorySlot?
  unlockedAt   DateTime          @default(now()) @db.Timestamptz(3)
  equippedAt   DateTime?         @db.Timestamptz(3)

  pet       UserPet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  accessory PetAccessory @relation(fields: [accessoryId], references: [id], onDelete: Restrict)

  @@unique([petId, accessoryId])
  @@unique([petId, equippedSlot])
}

// ───────────────────────────── Quests ─────────────────────────────

/// System quests have familyId = null; families may add their own quests.
model Quest {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String?       @unique @db.VarChar(60)
  familyId       String?       @db.Uuid
  createdById    String?       @db.Uuid
  title          String        @db.VarChar(80)
  description    String        @db.VarChar(280)
  icon           String        @default("target") @db.VarChar(40)
  period         QuestPeriod
  scope          QuestScope
  goalType       QuestGoalType
  goalTarget     Int
  xpReward       Int
  familyXpReward Int           @default(0)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  family    Family?         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("QuestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  progress  QuestProgress[]

  @@index([familyId, isActive])
}

/// periodKey: "2026-11-21" for DAILY, "2026-W47" for WEEKLY (in the subject's timezone).
/// USER scope → userId set, familyId null. FAMILY scope → familyId set, userId null.
model QuestProgress {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questId     String              @db.Uuid
  userId      String?             @db.Uuid
  familyId    String?             @db.Uuid
  periodKey   String              @db.VarChar(12)
  progress    Int                 @default(0)
  target      Int
  status      QuestProgressStatus @default(IN_PROGRESS)
  completedAt DateTime?           @db.Timestamptz(3)
  claimedAt   DateTime?           @db.Timestamptz(3)
  claimedById String?             @db.Uuid
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)

  quest  Quest   @relation(fields: [questId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([questId, userId, periodKey])
  @@unique([questId, familyId, periodKey])
  @@index([userId, periodKey])
  @@index([familyId, periodKey])
}

// ───────────────────────────── Rewards ─────────────────────────────

model Reward {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId    String    @db.Uuid
  createdById String    @db.Uuid
  title       String    @db.VarChar(80)
  description String?   @db.VarChar(280)
  icon        String    @default("gift") @db.VarChar(40)
  xpCost      Int
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  family      Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("RewardCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  redemptions RewardRedemption[]

  @@index([familyId, isActive])
}

/// PENDING → APPROVED → REDEEMED, or REJECTED / CANCELLED.
/// XP is deducted exactly once, on approval (ledger idempotency key "redemption:<id>:spend").
model RewardRedemption {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rewardId       String           @db.Uuid
  familyId       String           @db.Uuid
  userId         String           @db.Uuid
  /// Cost snapshot at request time.
  xpCost         Int
  status         RedemptionStatus @default(PENDING)
  note           String?          @db.VarChar(280)
  decisionNote   String?          @db.VarChar(280)
  decidedById    String?          @db.Uuid
  decidedAt      DateTime?        @db.Timestamptz(3)
  redeemedAt     DateTime?        @db.Timestamptz(3)
  idempotencyKey String           @db.VarChar(64)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  reward    Reward @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User   @relation("RedemptionRequester", fields: [userId], references: [id], onDelete: Restrict)
  decidedBy User?  @relation("RedemptionDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([familyId, status, createdAt])
  @@index([userId, createdAt])
}

// ───────────────────────────── Notifications / Sync / Audit ─────────────────────────────

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(120)
  body      String           @db.VarChar(400)
  data      Json?
  readAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// Server-side record of every offline operation pushed by a client.
/// Replaying the same operationId returns the stored result (idempotent).
model SyncOperation {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String              @db.Uuid
  operationId     String              @db.Uuid
  type            SyncOperationType
  payload         Json
  status          SyncOperationStatus @default(PENDING)
  result          Json?
  errorCode       String?             @db.VarChar(60)
  clientCreatedAt DateTime?           @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?           @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operationId])
  @@index([userId, status, createdAt])
}

/// Append-only security/audit trail (UPDATE/DELETE blocked by trigger).
/// Deliberately has no foreign keys so audit history outlives the rows it describes.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @db.Uuid
  familyId   String?  @db.Uuid
  action     String   @db.VarChar(60)
  entityType String   @db.VarChar(40)
  entityId   String?  @db.Uuid
  metadata   Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([familyId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

// ─────────────────────────────── AI ───────────────────────────────
// AI only proposes; accepted proposals go through the normal services (see src/ai).

enum AIFeature {
  COACH_RECOMMEND
  COACH_CHAT
  PLANNER
  PET
  ANALYTICS
}

enum AIUsageStatus {
  SUCCESS
  ERROR
}

enum AIRecommendationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum AIMessageRole {
  USER
  ASSISTANT
}

model AIUserPreference {
  userId                 String           @id @db.Uuid
  aiEnabled              Boolean          @default(true)
  goals                  String?          @db.VarChar(500)
  availableMinutesPerDay Int?
  preferredDifficulty    HabitDifficulty?
  updatedAt              DateTime         @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIConversation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @db.Uuid
  feature       AIFeature @default(COACH_CHAT)
  title         String    @db.VarChar(80)
  lastMessageAt DateTime  @default(now()) @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, lastMessageAt])
}

model AIMessage {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String        @db.Uuid
  role           AIMessageRole
  content        String        @db.VarChar(4000)
  /// Validated structured output (assistant messages)
  structured     Json?
  /// Client idempotency key for user messages (retries do not duplicate turns)
  clientKey      String?       @db.VarChar(80)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientKey])
  @@index([conversationId, createdAt])
}

model AIRecommendation {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String                 @db.Uuid
  /// Client idempotency key of the request that produced it (retries return the same set)
  requestKey     String                 @db.VarChar(80)
  position       Int
  status         AIRecommendationStatus @default(PENDING)
  goal           String                 @db.VarChar(500)
  /// Validated proposal: title, description, difficulty, frequency, scheduleDays, ...
  payload        Json
  createdHabitId String?                @db.Uuid
  expiresAt      DateTime               @db.Timestamptz(3)
  decidedAt      DateTime?              @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)

  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdHabit Habit?                    @relation(fields: [createdHabitId], references: [id], onDelete: SetNull)
  feedback     AIRecommendationFeedback?

  @@unique([userId, requestKey, position])
  @@index([userId, status, createdAt])
}

model AIRecommendationFeedback {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recommendationId String   @unique @db.Uuid
  reason           String?  @db.VarChar(300)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  recommendation AIRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
}

/// Token accounting per AI call. Never stores prompts or personal data.
model AIUsageLog {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String        @db.Uuid
  provider      String        @db.VarChar(30)
  model         String        @db.VarChar(80)
  feature       AIFeature
  inputTokens   Int           @default(0)
  outputTokens  Int           @default(0)
  totalTokens   Int           @default(0)
  estimatedCost Float?
  latencyMs     Int           @default(0)
  status        AIUsageStatus
  errorCode     String?       @db.VarChar(40)
  requestId     String?       @db.VarChar(120)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

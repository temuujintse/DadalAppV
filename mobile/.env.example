# Base URL of the Family Habit API (no trailing slash).
# Leave unset in development: the app derives http://<metro-host>:3000/api/v1 automatically,
# which works for the iOS simulator and for phones on the same Wi-Fi.
# Android emulator without Metro host detection: http://10.0.2.2:3000/api/v1
# EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
